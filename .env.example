# =========================================
# TAG 认证配置 (推荐首选 TAG_TOKEN)
# =========================================
# 获取方法：在电脑浏览器登录 TAG 后，按 F12 -> 打开控制台(Console) -> 输入 localStorage.getItem("auth_data") 回车即可复制
TAG_TOKEN=your_token_here

# 备选账号密码（如果站点开启极验滑块则需要用上面的 Token）
TAG_EMAIL=your_email@example.com
TAG_PASSWORD=your_password

# =========================================
# 邮件推送配置 (SMTP)
# =========================================
# 示例 1：QQ 邮箱 (host: smtp.qq.com, port: 465, 密码为在 QQ 邮箱设置里生成的 POP3/SMTP 授权码)
# 示例 2：163 邮箱 (host: smtp.163.com, port: 465, 密码为 163 客户端授权密码)
# 示例 3：Gmail (host: smtp.gmail.com, port: 465, 密码为 Google 账号的安全应用密码)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_number@qq.com
SMTP_PASS=your_smtp_auth_code
NOTIFY_EMAIL=recipient@example.com

# 首次运行是否强制发送最新一条公告进行测试 (true/false)
FIRST_RUN_NOTIFY=false
