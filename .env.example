# ================================================================
# TAG 官方认证配置 (二选一即可，优先推荐配置 TAG_TOKEN)
# ================================================================
# 方式 1（推荐）：直接使用 Token
# 获取方法：电脑浏览器登录 TAG 官网，按 F12 打开开发者工具 -> Console(控制台)
# 输入 localStorage.getItem("token") 或 localStorage.getItem("tag:token") 回车复制输出字符串
TAG_TOKEN=your_token_here

# 方式 2（备选）：账号密码自动登录
# 若未提供 TAG_TOKEN，脚本将自动使用以下账号密码登录官方 API 获取 Token
TAG_EMAIL=your_account@example.com
TAG_PASSWORD=your_password

# TAG API 网关（可选，默认使用内置官方加速网关）
# TAG_API_BASE=https://3lcjqnejlt8iz5iq.tagss-verification.org

# ================================================================
# SMTP 邮件推送配置
# ================================================================
# 示例：QQ 邮箱 (host: smtp.qq.com, port: 465, 密码为在 QQ 邮箱设置中生成的 POP3/SMTP 授权码)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code
NOTIFY_EMAIL=recipient@example.com

# 首次运行是否发送测试邮件 (true/false)
FIRST_RUN_NOTIFY=false
